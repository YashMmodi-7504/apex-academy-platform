# Apex Academy Environment Configuration
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# NEVER commit real credentials to this file — it is tracked in version control.

# Server Settings
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — SERVER SIDE (never exposed to the browser)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# SERVICE ROLE KEY — bypasses all Row Level Security. Treat as a root credential.
# Required: the server fails to start without it. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---------------------------------------------------------------------------
# Supabase — CLIENT SIDE (bundled into the browser, safe to be public)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_publishable_key_here

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# NOTE: these are currently unused by the application — authentication is handled
# entirely by Supabase GoTrue, which signs its own tokens. Retained for future use.
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Google Gemini (server side only — used for AI quiz generation)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# App Host URL (injected by the hosting platform)
APP_URL=http://localhost:3000
